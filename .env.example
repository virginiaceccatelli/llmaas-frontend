# Copy to .env and adjust.  .env is gitignored — never commit real secrets.
#   Copy-Item .env.example .env

# ---------------------------------------------------------------------------
# Where the broker is
# ---------------------------------------------------------------------------
# Laptop: the broker on localhost. On the VMs: the gateway VM's PRIVATE ip,
# which must not be reachable from the internet.
BROKER_URL=http://127.0.0.1:8080
BROKER_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# How we prove to the broker which user we are acting for.
# MUST match the broker's AUTH_MODE. See LLMaaS/docs/AUTH.md.
# ---------------------------------------------------------------------------
# "dev"   - send an unverified X-Dev-User header (LOCAL ONLY)
# "hs256" - mint a short-lived JWT signed with a shared secret (recommended)
BROKER_AUTH_MODE=dev

# For BROKER_AUTH_MODE=hs256. Must be byte-identical to the broker's
# AUTH_JWT_SECRET. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_JWT_SECRET=
# These must match the broker's AUTH_JWT_ISSUER / AUTH_JWT_AUDIENCE.
AUTH_JWT_ISSUER=llmaas-frontend
AUTH_JWT_AUDIENCE=llmaas-broker
AUTH_JWT_TTL_S=300

# ---------------------------------------------------------------------------
# Browser session
# ---------------------------------------------------------------------------
# Signs the session cookie. Unset = a random one per start, so every restart
# signs everyone out. Generate as above.
# SESSION_SECRET=
SESSION_TTL_S=28800
# MUST be true anywhere but localhost: the cookie is a bearer credential.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Login
# ---------------------------------------------------------------------------
# JSON file of users with scrypt password hashes. Create entries with:
#   python scripts/users.py add alice
USERS_FILE=users.json
# LOCAL ONLY: with no users file, anyone may sign in as any user id.
# Set to false before exposing this to a network.
ALLOW_PASSWORDLESS=true

# ---------------------------------------------------------------------------
# Chat
# ---------------------------------------------------------------------------
# /v1/* needs an API key, not a login. When true the BFF mints one key per
# browser session and revokes it at sign-out, so chat works with no manual
# key handling. Turn off to force users to paste their own key.
AUTO_MINT_SESSION_KEY=true
SESSION_KEY_LABEL=web-ui session

HOST=127.0.0.1
PORT=8081
